# ADG CodeGraph Tier-2 legacy boundary template.
#
# CodeGraph itself treats a file named .codegraphignore as a directory marker,
# not as a gitignore-style pattern file. ADG's hardened wrapper therefore
# stages a sanitized /workspace and hides this root file before invoking
# CodeGraph. Keep this file only for ADG consumer-boundary documentation and
# validator compatibility; do not place .codegraphignore marker files in
# directories that should be indexed.

# Tier boundaries: Astaire owns ADG governance artifacts; docs stay out of the
# default CodeGraph product-code scope.
adg/**
ai-dev-governance/**
vendor/ai-dev-governance/**
submodules/ai-dev-governance/**
docs/**

# Build, dependency, cache, and generated output.
.codegraph/evidence/**
.git/**
.venv/**
venv/**
node_modules/**
dist/**
build/**
out/**
target/**
coverage/**
.pytest_cache/**
.mypy_cache/**
.ruff_cache/**
__pycache__/**
*.pyc

# Secret-bearing paths mirror the restricted Graphify precedent.
secrets/**
**/secrets/**
.env
**/.env
.env.*
**/*.pem
**/*.key
**/id_rsa*
**/credentials*
**/*.kdbx
