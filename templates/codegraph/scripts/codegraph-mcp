#!/bin/sh
set -eu

usage() {
  cat >&2 <<'USAGE'
Usage: codegraph-mcp [codegraph args...]

Environment:
  ADG_CONTAINER_RUNTIME   Override runtime (podman, docker, nerdctl, or path).
  ADG_CODEGRAPH_IMAGE     Image repository/name. Default: localhost/codegraph-mcp.
  ADG_CODEGRAPH_DIGEST    Digest file. Default: .codegraph/image.digest.
  ADG_CODEGRAPH_SOURCE    Source tree to mount read-only. Default: current dir.
  ADG_CODEGRAPH_VOLUME    Named volume for /workspace/.codegraph.
  ADG_CODEGRAPH_PREPARE_VOLUME
                          Set to 0 to skip one-shot volume ownership prep.
  ADG_CODEGRAPH_STAGE_SOURCE
                          Set to 0 to mount source directly instead of staging
                          a sanitized /workspace inside the container.
  ADG_CODEGRAPH_LOCK_RETRIES
                          Lock-contention retries before giving up. Default: 6.
  ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS
                          Seconds between lock retries. Default: 1.
  ADG_CODEGRAPH_PLATFORM  Platform override. Default: host-derived linux/amd64 or linux/arm64.
USAGE
}

die() {
  printf 'codegraph-mcp: %s\n' "$*" >&2
  exit 1
}

find_runtime() {
  if [ "${ADG_CONTAINER_RUNTIME:-}" ]; then
    command -v "$ADG_CONTAINER_RUNTIME" >/dev/null 2>&1 || die "ADG_CONTAINER_RUNTIME not found: $ADG_CONTAINER_RUNTIME"
    printf '%s\n' "$ADG_CONTAINER_RUNTIME"
    return 0
  fi

  for runtime in podman docker nerdctl; do
    if command -v "$runtime" >/dev/null 2>&1; then
      printf '%s\n' "$runtime"
      return 0
    fi
  done

  die 'no supported container runtime found (searched: podman, docker, nerdctl)'
}

host_platform() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'linux/amd64\n' ;;
    arm64|aarch64) printf 'linux/arm64\n' ;;
    *) die "unsupported host architecture: $(uname -m)" ;;
  esac
}

absolute_path() {
  path=$1
  if [ -d "$path" ]; then
    (cd "$path" && pwd -P)
    return 0
  fi
  die "source directory does not exist: $path"
}

volume_name() {
  source_path=$1
  base=$(basename "$source_path" | tr -c 'A-Za-z0-9_.-' '_')
  stamp=$(printf '%s' "$source_path" | cksum | awk '{print $1}')
  printf 'adg_codegraph_%s_%s\n' "$base" "$stamp"
}

prepare_volume_owner() {
  [ "${ADG_CODEGRAPH_PREPARE_VOLUME:-1}" = "0" ] && return 0

  "$runtime" volume create "$cache_volume" >/dev/null 2>&1 || true
  "$runtime" run --rm \
    --platform "$platform" \
    --network=none \
    --cap-drop=ALL \
    --cap-add=CHOWN \
    --security-opt=no-new-privileges:true \
    --pids-limit=64 \
    --memory=128m \
    --cpus=1 \
    --ipc=none \
    --user 0:0 \
    --mount "type=bind,src=$source_dir,dst=/workspace,readonly" \
    --mount "type=volume,src=$cache_volume,dst=/workspace/.codegraph" \
    --workdir /workspace \
    --entrypoint /bin/sh \
    "$image_ref" -c "mkdir -p /workspace/.codegraph && chown -R $uid_gid /workspace/.codegraph" \
    >/dev/null
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

runtime=$(find_runtime)
source_dir=$(absolute_path "${ADG_CODEGRAPH_SOURCE:-.}")
digest_file=${ADG_CODEGRAPH_DIGEST:-"$source_dir/.codegraph/image.digest"}
[ -f "$digest_file" ] || die "image digest file not found: $digest_file"

digest=$(tr -d '[:space:]' < "$digest_file")
[ "$digest" ] || die "image digest file is empty: $digest_file"

case "$digest" in
  *@sha256:*) image_ref=$digest ;;
  sha256:*)
    if "$runtime" image inspect "$digest" >/dev/null 2>&1; then
      image_ref=$digest
    else
      image_ref="${ADG_CODEGRAPH_IMAGE:-localhost/codegraph-mcp}@$digest"
    fi
    ;;
  *) die "image digest must be sha256:<hex> or image@sha256:<hex>: $digest" ;;
esac

platform=${ADG_CODEGRAPH_PLATFORM:-$(host_platform)}
cache_volume=${ADG_CODEGRAPH_VOLUME:-$(volume_name "$source_dir")}
uid_gid="$(id -u):$(id -g)"

prepare_volume_owner

if [ "${ADG_CODEGRAPH_STAGE_SOURCE:-1}" = "0" ]; then
  exec "$runtime" run --rm -i \
    --platform "$platform" \
    --read-only \
    --tmpfs /tmp:size=64m,mode=1777 \
    --network=none \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    --pids-limit=512 \
    --memory=2g \
    --cpus=2 \
    --ulimit nofile=4096:4096 \
    --ipc=none \
    --user "$uid_gid" \
    --env "ADG_CODEGRAPH_LOCK_RETRIES=${ADG_CODEGRAPH_LOCK_RETRIES:-6}" \
    --env "ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS=${ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS:-1}" \
    --mount "type=bind,src=$source_dir,dst=/workspace,readonly" \
    --mount "type=volume,src=$cache_volume,dst=/workspace/.codegraph" \
    --workdir /workspace \
    --entrypoint /bin/sh \
    "$image_ref" -c '
set -eu

is_mcp_serve() {
  [ "${1:-}" = "serve" ] || return 1
  shift
  for arg in "$@"; do
    [ "$arg" = "--mcp" ] && return 0
  done
  return 1
}

wait_for_codegraph_lock() {
  retries=${ADG_CODEGRAPH_LOCK_RETRIES:-6}
  delay=${ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS:-1}
  attempt=0
  while [ -e /workspace/.codegraph/codegraph.lock ] && [ "$attempt" -lt "$retries" ]; do
    attempt=$((attempt + 1))
    printf "codegraph-mcp: CodeGraph lock present; retrying in %ss (%s/%s)\n" "$delay" "$attempt" "$retries" >&2
    sleep "$delay"
  done
}

run_with_lock_retry() {
  retries=${ADG_CODEGRAPH_LOCK_RETRIES:-6}
  delay=${ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS:-1}
  attempt=0
  while :; do
    out=/tmp/codegraph-mcp.$$.out
    err=/tmp/codegraph-mcp.$$.err
    if node /app/dist/bin/codegraph.js "$@" >"$out" 2>"$err"; then
      cat "$out"
      cat "$err" >&2
      rm -f "$out" "$err"
      return 0
    fi
    status=$?
    if cat "$out" "$err" | grep -qiE "database is locked|locked by another process|SQLITE_BUSY|codegraph.lock" \
      && [ "$attempt" -lt "$retries" ]; then
      attempt=$((attempt + 1))
      rm -f "$out" "$err"
      printf "codegraph-mcp: CodeGraph lock contention; retrying in %ss (%s/%s)\n" "$delay" "$attempt" "$retries" >&2
      sleep "$delay"
      continue
    fi
    cat "$out"
    cat "$err" >&2
    rm -f "$out" "$err"
    return "$status"
  done
}

wait_for_codegraph_lock
if is_mcp_serve "$@"; then
  exec node /app/dist/bin/codegraph.js "$@"
fi
run_with_lock_retry "$@"
' _ "$@"
fi

exec "$runtime" run --rm -i \
  --platform "$platform" \
  --read-only \
  --tmpfs /tmp:size=64m,mode=1777 \
  --tmpfs /workspace:size=32m,mode=1777 \
  --network=none \
  --cap-drop=ALL \
  --security-opt=no-new-privileges:true \
  --pids-limit=512 \
  --memory=2g \
  --cpus=2 \
  --ulimit nofile=4096:4096 \
  --ipc=none \
  --user "$uid_gid" \
  --env "ADG_CODEGRAPH_LOCK_RETRIES=${ADG_CODEGRAPH_LOCK_RETRIES:-6}" \
  --env "ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS=${ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS:-1}" \
  --mount "type=bind,src=$source_dir,dst=/workspace-source,readonly" \
  --mount "type=volume,src=$cache_volume,dst=/workspace/.codegraph" \
  --workdir /workspace \
  --entrypoint /bin/sh \
  "$image_ref" -c '
set -eu
for entry in /workspace-source/.[!.]* /workspace-source/..?* /workspace-source/*; do
  [ -e "$entry" ] || continue
  name=${entry##*/}
  case "$name" in
    .|..|.codegraph|.codegraphignore|.git|.governance|adg|ai-dev-governance|docs|secrets|node_modules|dist|build|out|target|coverage|.venv|venv|.pytest_cache|.mypy_cache|.ruff_cache|__pycache__)
      continue
      ;;
  esac
  ln -s "$entry" "/workspace/$name"
done

is_mcp_serve() {
  [ "${1:-}" = "serve" ] || return 1
  shift
  for arg in "$@"; do
    [ "$arg" = "--mcp" ] && return 0
  done
  return 1
}

wait_for_codegraph_lock() {
  retries=${ADG_CODEGRAPH_LOCK_RETRIES:-6}
  delay=${ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS:-1}
  attempt=0
  while [ -e /workspace/.codegraph/codegraph.lock ] && [ "$attempt" -lt "$retries" ]; do
    attempt=$((attempt + 1))
    printf "codegraph-mcp: CodeGraph lock present; retrying in %ss (%s/%s)\n" "$delay" "$attempt" "$retries" >&2
    sleep "$delay"
  done
}

run_with_lock_retry() {
  retries=${ADG_CODEGRAPH_LOCK_RETRIES:-6}
  delay=${ADG_CODEGRAPH_LOCK_BACKOFF_SECONDS:-1}
  attempt=0
  while :; do
    out=/tmp/codegraph-mcp.$$.out
    err=/tmp/codegraph-mcp.$$.err
    if node /app/dist/bin/codegraph.js "$@" >"$out" 2>"$err"; then
      cat "$out"
      cat "$err" >&2
      rm -f "$out" "$err"
      return 0
    fi
    status=$?
    if cat "$out" "$err" | grep -qiE "database is locked|locked by another process|SQLITE_BUSY|codegraph.lock" \
      && [ "$attempt" -lt "$retries" ]; then
      attempt=$((attempt + 1))
      rm -f "$out" "$err"
      printf "codegraph-mcp: CodeGraph lock contention; retrying in %ss (%s/%s)\n" "$delay" "$attempt" "$retries" >&2
      sleep "$delay"
      continue
    fi
    cat "$out"
    cat "$err" >&2
    rm -f "$out" "$err"
    return "$status"
  done
}

wait_for_codegraph_lock
if is_mcp_serve "$@"; then
  exec node /app/dist/bin/codegraph.js "$@"
fi
run_with_lock_retry "$@"
' _ "$@"
