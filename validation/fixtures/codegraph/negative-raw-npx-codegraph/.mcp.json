{
  "mcpServers": {
    "codegraph": {
      "command": "npx codegraph",
      "args": ["--transport", "stdio"],
      "env": {
        "ADG_CODEGRAPH_DIGEST": ".codegraph/image.digest",
        "ADG_CODEGRAPH_IMAGE": "localhost/codegraph-mcp",
        "ADG_CODEGRAPH_SOURCE": "."
      }
    }
  }
}
